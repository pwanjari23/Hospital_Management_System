{
  "name": "hms-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Hospital Management System - Backend API",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "db:migrate": "node src/database/migrator.js up",
    "db:migrate:undo": "node src/database/migrator.js down",
    "db:seed": "node src/database/migrator.js seed",
    "db:seed:undo": "node src/database/migrator.js seed:undo",
    "test:db": "node src/database/verify.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3"
  }
}
