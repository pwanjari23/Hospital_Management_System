{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready, secure, multi-tenant Hospital Management System (HMS) SaaS",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:migrate:undo": "npm --prefix server run db:migrate:undo",
    "db:seed": "npm --prefix server run db:seed",
    "db:seed:undo": "npm --prefix server run db:seed:undo",
    "test": "npm --prefix server run test",
    "test:db": "npm --prefix server run test:db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:restart": "docker compose restart postgres",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
